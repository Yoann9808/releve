# Copier en .env.local (ignoré par git). Aucune clé réelle dans le dépôt.
# Aucune de ces variables n'est nécessaire pour le parcours de score sans compte (PR 000).

# PostHog (événements produit anonymes). Sans clé, les événements sont ignorés.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase (compte par lien magique, PR suivante)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (e-mail du lien magique et du résultat, PR suivante)
RESEND_API_KEY=
