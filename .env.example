# Modèle des variables d'environnement. Aucune clé réelle dans ce fichier.
# En local : copier en .env.local (ignoré par git). En production : les mêmes noms dans Vercel.
# Le parcours de score sans compte fonctionne sans aucune de ces variables.

# --- Supabase, projet `releve` (qgcufrjyactycvkwyfxq, Paris) ---
# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://qgcufrjyactycvkwyfxq.supabase.co
# « Secret key » (sb_secret_…). Serveur uniquement : accès total à la base, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# « Publishable key » (sb_publishable_…). Pas encore utilisée : lien magique, étape B.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Resend (e-mail du résultat) ---
# resend.com → API Keys.
RESEND_API_KEY=
# Tant qu'aucun domaine n'est vérifié, Resend n'envoie qu'à l'adresse du compte.
RESEND_FROM=Relève <onboarding@resend.dev>

# --- Facultatif ---
# Adresse publique du site pour les liens des e-mails (ex. https://releve.fr).
# Sinon : domaine de production Vercel, puis l'adresse de la requête (en local).
SITE_URL=

# PostHog (événements produit anonymes). Sans clé, les événements sont ignorés.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
