# Copier en .env.local (ignoré par git). Aucune clé réelle dans le dépôt.
# Le parcours de score sans compte fonctionne sans aucune de ces variables.

# PostHog (événements produit anonymes). Sans clé, les événements sont ignorés.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase, projet `releve` (eu-west-3, Paris). Migration : supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=
# Serveur uniquement (jamais préfixée NEXT_PUBLIC_). Clé secrète ou service_role du projet.
SUPABASE_SERVICE_ROLE_KEY=
# Lien magique (étape B, pas encore utilisée)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (e-mail du résultat). Tant qu'aucun domaine n'est vérifié, Resend n'envoie qu'à l'adresse du compte.
RESEND_API_KEY=
RESEND_FROM=Relève <onboarding@resend.dev>

# Facultatif : adresse publique du site pour les liens des e-mails (ex. https://releve.fr).
# Sinon : domaine de production Vercel, puis l'adresse de la requête (en local).
SITE_URL=
